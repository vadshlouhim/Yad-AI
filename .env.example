# Local development: Stripe TEST only. Production: configure the LIVE values
# in the Netlify environment, never in this file.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Transactional authentication email (server-side only).
RESEND_API_KEY=
AUTH_EMAIL_FROM="EasyCom IA <noreply@easycom-ai.com>"
# Durable anti-abuse rate limiting for the public registration endpoint.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Numéro international sans + ni espaces pour le bouton « Partager mon idée ».
NEXT_PUBLIC_WHATSAPP_NUMBER=33668508898
# Opt in only when local automation scheduling is explicitly needed.
AUTOMATION_LOCAL_SCHEDULER=false
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring EUR Price at 19.99/month. Use a test-mode price locally.
STRIPE_PRICE_MONTHLY_1999=
STRIPE_PORTAL_CONFIGURATION_ID=

# 32 random bytes encoded in base64; encrypts third-party integration secrets.
INTEGRATION_ENCRYPTION_KEY=

# Optional override. EasyCom uses this official Unisoft/Kehila API by default.
UNISOFT_API_BASE_URL=https://api.kehila.syn-assist.fr/integrations/v1

# Development only: persist simulated publications without contacting social networks.
# Required in local development: records simulated publications without contacting networks.
PUBLISH_DRY_RUN=true
